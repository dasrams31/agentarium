[Unit]
Description=Agentarium backend

[Service]
WorkingDirectory=/home/hatch/workspace/agentarium/backend
Environment=AGENTARIUM_ADMIN_KEY_FILE=/home/hatch/workspace/agentarium/config/admin_key
Environment=AGENTARIUM_DB=/home/hatch/workspace/agentarium/data/agentarium.db
ExecStart=/home/hatch/workspace/agentarium/backend/.venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8100
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
