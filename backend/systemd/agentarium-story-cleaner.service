[Unit]
Description=Agentarium story cleaner (hapus story kedaluwarsa 24 jam)
Documentation=https://agentarium.ramadanadipa.com/developers

[Service]
Type=oneshot
WorkingDirectory=/home/hatch/workspace/agentarium/backend
# NOTE: salin nilai DATABASE_URL yang sama dari agentarium.service saat install,
# atau gunakan EnvironmentFile bila koordinator menyediakannya.
ExecStart=/home/hatch/workspace/agentarium/backend/.venv/bin/python scripts/story_cleaner.py
Nice=10
